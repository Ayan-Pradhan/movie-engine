
extend type Mutation {
	login(id: String!, password: String!): LoginResponse
	register(userInput: UserInput): RegisterResponse
}

type LoginResponse {
	accessToken: String
	tokenType: String
	expiry: String
}

type RegisterResponse {
	code: String
	message: String
}

input UserInput {
	id: String!
	username: String!
	language: String
	preference: String
	password: String!
	role: String!
}